# Spotify — paste embed iframe src OR a playlist/album link from Spotify
# VITE_SPOTIFY_EMBED_URL=https://open.spotify.com/embed/playlist/YOUR_ID?utm_source=generator
# VITE_SPOTIFY_TITLE=Party playlist
# VITE_SPOTIFY_DESCRIPTION=Warm up before you arrive.
# Collaborator invite — Spotify playlist → ⋯ → Invite collaborators → Copy link
# VITE_SPOTIFY_COLLAB_URL=https://open.spotify.com/...
# VITE_SPOTIFY_COLLAB_LABEL=Add songs — join as collaborator

# VITE_HERO_WATERMARK=
